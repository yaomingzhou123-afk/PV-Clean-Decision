# ==============================================================
# PV-Clean-Decision 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不要提交或打包
# ==============================================================

# --- LLM（可选，不配置时主决策链路自动降级为纯规则引擎） ---
# 华为云 ModelArts MaaS 或任意 OpenAI 兼容接口
LLM_BASE_URL=https://api.modelarts-maas.com/v2
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-1017
# LLM_TIMEOUT=30

# --- 数据源（全部免 API Key，仅网络超时/重试/缓存策略） ---
# DS_TIMEOUT=10          # 单次请求超时（秒）
# DS_RETRIES=2          # 失败重试次数
# DS_CACHE_TTL=21600     # PVGIS 缓存有效期（秒，默认 6 小时）
# NASA_POWER_ENABLED=0   # NASA POWER 可选源（默认关闭，未接入主决策链路）

# --- 服务与工程 ---
# PORT=8001             # 后端监听端口（默认 8001）
# MCP_ENABLED=1         # 是否启用 MCP 子进程（默认 1；设 0 走进程内直连）
# LOG_LEVEL=INFO        # 日志级别：DEBUG / INFO / WARNING / ERROR
